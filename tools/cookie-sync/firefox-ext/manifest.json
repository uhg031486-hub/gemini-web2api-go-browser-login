{
  "manifest_version": 2,
  "name": "Gemini — Đồng bộ phiên (Firefox)",
  "version": "1.2.3",
  "description": "Lưu nhiều tài khoản Gemini trên Firefox (kể cả tab ẩn danh) và đồng bộ phiên về máy chủ gemini-web2api tự duy trì.",
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "gw2a-cookie-sync@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "tabs",
    "https://*.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Gemini — Đồng bộ phiên (Firefox)",
    "default_popup": "popup.html"
  }
}
